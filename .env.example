# Copy this file to .env and fill in real values. .env is gitignored.

# Groq (only remote dependency for the May 30 demo — free tier)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Local STT
WHISPER_MODEL=small

# Local embeddings
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIM=768

# Vector store
CHROMA_DIR=./chroma_db
TOP_K=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35

# Response shaping
RESPONSE_WORD_LIMIT=150

# Conversation window
CONVERSATION_WINDOW_MINUTES=5
TRIGGER_WORDS=that's enough,okay thank you,thank you,next question

# TTS voice (Piper, local neural TTS). Voice models are downloaded once
# into ./models/piper/ on first use (~30-60 MB each, then cached).
#
# Default en_US-lessac-high — a US male voice trained on the Lessac
# vocal-arts method, with intentionally varied prosody. Sounds engaged
# and formal, well-suited to CJ's persona.
#
# Other male options ranked by "engaging-ness" then "formal":
#   en_US-lessac-high      ENGAGING + FORMAL — expressive American (recommended)
#   en_GB-alan-medium      FORMAL — measured British, BBC-presenter feel
#   en_US-bryce-medium     warm American male, conversational
#   en_US-joe-medium       US male, mid-tone, less expressive
#   en_US-ryan-high        US male, deep but flat (try if lessac is too dramatic)
#   en_US-norman-medium    older US male, authoritative
TTS_VOICE_PIPER=en_US-lessac-high
