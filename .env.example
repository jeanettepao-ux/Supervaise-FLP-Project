# Copy this file to .env and fill in real values. .env is gitignored.

# Groq (only remote dependency for the May 30 demo — free tier)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Local STT
WHISPER_MODEL=small

# Local embeddings
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIM=768

# Vector store
CHROMA_DIR=./chroma_db
TOP_K=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35

# Response shaping
RESPONSE_WORD_LIMIT=150

# Conversation window
CONVERSATION_WINDOW_MINUTES=5
TRIGGER_WORDS=that's enough,okay thank you,thank you,next question

# TTS voice (Piper, local neural TTS). Default en_US-ryan-high is a US
# male voice with gravitas. Other male options:
#   en_US-ryan-medium     smaller / faster
#   en_US-bryce-medium    different US male
#   en_US-joe-medium      US male, mid-tone
#   en_GB-alan-medium     British male, measured
# Voice models are downloaded once into ./models/piper/ on first use.
TTS_VOICE_PIPER=en_US-ryan-high
