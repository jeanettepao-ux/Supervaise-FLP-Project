# Copy this file to .env and fill in real values. .env is gitignored.

# Groq (only remote dependency for the May 30 demo — free tier)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Local STT
WHISPER_MODEL=small

# Local embeddings
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIM=768

# Vector store
CHROMA_DIR=./chroma_db
TOP_K=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35

# Response shaping
RESPONSE_WORD_LIMIT=150

# Conversation window
CONVERSATION_WINDOW_MINUTES=5
TRIGGER_WORDS=that's enough,okay thank you,thank you,next question

# TTS voice (Piper, local neural TTS). Voice models are downloaded once
# into ./models/piper/ on first use (~30-60 MB each, then cached).
#
# Default en_US-bryce-medium — a US male voice, conversational and warm.
#
# Verified MALE male options:
#   en_US-bryce-medium     conversational American (default — recommended)
#   en_GB-alan-medium      measured British, BBC-presenter feel
#   en_US-joe-medium       US male, mid-tone
#   en_US-ryan-high        US male, deep but flat delivery
#   en_US-norman-medium    older US male, authoritative
#
# WATCH OUT: en_US-lessac-* and en_US-amy-* are FEMALE voices despite
# the unisex-sounding names — confirm with a test before assuming.
TTS_VOICE_PIPER=en_US-bryce-medium

# Pause inserted between sentences in TTS output (seconds). Default 0.4
# gives natural pacing. Set to 0 to disable pauses. Set to 0.6+ for
# slower / more deliberate delivery.
TTS_SENTENCE_PAUSE=0.4

# For sentences longer than TTS_LONG_SENTENCE_WORDS, also insert a
# shorter pause at every comma / semicolon so the speech sounds like a
# real person taking breaths instead of one long monotone wall.
# Set TTS_CLAUSE_PAUSE=0 to disable clause-level pausing entirely.
TTS_CLAUSE_PAUSE=0.18
TTS_LONG_SENTENCE_WORDS=14
